{
  "shared_memory": {
    "size_mb": 64,
    "backing_path": "/tmp/tigonkv-multivm-trace-backing",
    "device_path": "/dev/ivpci0",
    "hwcc": { "offset_mb": 0, "size_mb": 32 },
    "swcc": { "offset_mb": 32, "size_mb": 32 }
  },
  "vm": { "count": 2 },
  "tigon_kv": {
    "partition_count": 8,
    "partitioning": {
      "strategy": "range",
      "ranges": [
        {"lower_key": "", "upper_key": "d"}, {"lower_key": "d", "upper_key": "h"},
        {"lower_key": "h", "upper_key": "l"}, {"lower_key": "l", "upper_key": "p"},
        {"lower_key": "p", "upper_key": "t"}, {"lower_key": "t", "upper_key": "x"},
        {"lower_key": "x", "upper_key": "z"}, {"lower_key": "z", "upper_key": ""}
      ]
    },
    "fixed_key_size": 32,
    "fixed_value_size": 128,
    "hw_cc_budget_mb": 32,
    "owner_private_swcc_fraction": 0.35,
    "migration_policy": "Clock",
    "when_to_move_out": "OnDemand",
    "scc_mechanism": "WriteThrough",
    "transport_ring_total_mb": 1,
    "verbose": false,
    "extra_check": false,
"latency_inject": {
      "fixed_latency": {
        "cache_line_bytes": 64,
        "swcc_fixed_ns_per_line": 0,
        "hwcc_fixed_ns_per_line": 0
      }
    }
  }
}
